	url = {https://ieeexplore.ieee.org/document/11305427},
	doi = {10.1109/ISGTEurope64741.2025.11305427},
	abstract = {The power systems are becoming a decentralized cyber-physical system with new energy demands, grid infrastructure, and renewable energy sources, introducing challenges in managing heterogeneous data across various domains within the energy domain. As a result, the harmonization of heterogeneous data becomes one of the possible solutions for the development and analysis of novel solutions in the energy domain. Semantic Web technologies serve as effective solutions to tackle the challenges of heterogeneous data integration across various sectors, including smart energy systems. By providing machine-readable information and facilitating a shared understanding of data for both humans and machines, these technologies, especially ontology, enable the linking of domain-specific information. To address this issue, we propose the development of SARGON2 ontology by using a semi-automatic ontology development framework that extends SARGON to enhance interoperability within the energy domain. SARGON2 extends SARGON ontology to cover more renewable energy resources, weather information, and power system components. By integrating the ontology with the existing standards, such as IEC61970 CIM, SARGON2 incorporates entities related to RES, building domains, and non-energy domains like weather information.},
	urldate = {2026-05-20},
	booktitle = {2025 {IEEE} {PES} {Innovative} {Smart} {Grid} {Technologies} {Conference} {Europe} ({ISGT} {Europe})},
	author = {Tun, Su Mon and Pan, Zhiyu and Hao, Fengshuo and Ponci, Ferdinanda and Monti, Antonello},
	month = oct,
	year = {2025},
	keywords = {CIM, Common Information Model (electricity), Europe, Interoperability, Ontologies, Power systems, Renewable energy sources, SARGON, Semantic Web, Semantics, Smart grids, Standards, ontology, semantic interoperability},
	pages = {1--5},
}

