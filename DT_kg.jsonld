  {
    "@id": "https://example.org/nedt",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Divyanshu Sood"
      },
      {
        "@value": "Cathal Hoare"
      },
      {
        "@value": "Sharon Coffee"
      },
      {
        "@value": "James O'Donnell"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "An OWL ontology describing building archetypes, hourly energy profiles, LV-network attribution, scenarios (including rooftop-PV adoption), KPI evaluation and visualisation components of the National Energy Digital Twin (NEDT) for Ireland."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-04-20T00:00:00+00:00"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-07-16T00:00:00+00:00"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "National Energy Digital Twin (NEDT) Ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.w3.org/ns/ssn/"
      },
      {
        "@id": "https://www.w3.org/2006/time"
      },
      {
        "@id": "http://www.ontology-of-units-of-measure.org/resource/om-2/"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.4.0"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Structurally aligned with Li et al. (2019) EM-KPI ontology and reuses SSN/SOSA for observations, OWL-Time for temporal intervals, OM-2 for units and GeoSPARQL for spatial geometries."
      }
    ]
  },
