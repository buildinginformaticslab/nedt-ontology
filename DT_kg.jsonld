  {
    "@id": "https://example.org/nedt#hasUpstreamAsset",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#TransitiveProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Transitive super-property of the parent-link properties. Because hasParentMVFeeder and hasParentHVSubstation are both sub-properties, an OWL 2 reasoner entails the full LV -> MV -> HV chain from the two published one-step links, so demand can be rolled up to any tier without materialising the closure in the A-Box."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
