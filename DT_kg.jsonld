  {
    "@id": "https://example.org/nedt#LVStation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A low-voltage distribution substation (ESB Networks). Each dwelling is assigned to exactly one station via hull polygon."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "LV Substation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://w3id.org/saragon#DistributionNode"
      },
      {
        "@id": "http://iec.ch/TC57/CIM100#PowerTransformer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/saragon#Transformer"
      },
      {
        "@id": "http://iec.ch/TC57/CIM100#Substation"
      },
      {
        "@id": "https://example.org/nedt#NetworkAsset"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://w3id.org/saragon#Transformer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "One-to-one with its MV/LV transformer in the ESB dataset, so the station also stands proxy for cim:PowerTransformer; the station's designed kVA is the transformer's cim:PowerTransformerEnd.ratedS."
      }
    ],
    "https://example.org/nedt#layer": [
      {
        "@language": "en",
        "@value": "core-KG-framework"
      }
    ]
  },
