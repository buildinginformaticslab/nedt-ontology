@prefix ex: <https://example.org/nedt-test#> .
@prefix nedt: <https://example.org/nedt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Deliberately invalid fixtures. The validation test must reject all of them.
ex:dwelling-no-station a nedt:Dwelling ;
  nedt:locatedInCounty ex:county ; nedt:instantiatesArchetype ex:archetype .
ex:station-negative-capacity a nedt:LVStation ;
  nedt:hasCapacityValue "-1"^^xsd:decimal ; nedt:hasCapacityImputed false .
ex:scenario-invalid-fraction a nedt:Scenario ;
  nedt:hasScenarioYear 2024 ; nedt:hasHPAdoptionFraction "1.2"^^xsd:decimal .
ex:archetype-invalid-ber a nedt:Archetype ;
  nedt:hasBuildType "Detached" ; nedt:hasBERCategory "Z" ;
  nedt:hasOccupancyCategory 3 .
ex:kpi-no-provenance a nedt:CapacityKPI ;
  nedt:forLVStation ex:station ; nedt:evaluatedUnderScenario ex:scenario ;
  nedt:hasPeakDemandKW "10"^^xsd:decimal ;
  nedt:hasRatedCapacityKVA "20"^^xsd:decimal ; nedt:hasUtilisation "0.5"^^xsd:decimal .
ex:transition-negative a nedt:TechnologyTransition ;
  nedt:fromArchetype ex:a ; nedt:toArchetype ex:b ; nedt:transitionCount -1 .
ex:observation-no-time a nedt:ValidationObservation ;
  nedt:hasMeasuredValue "1"^^xsd:decimal .
ex:county-no-label a nedt:County .
ex:aggregate-no-calibration a nedt:CountyDemandAggregate .
