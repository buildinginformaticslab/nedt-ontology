nedt:NexsysProfile a owl:Class ;
    rdfs:label "Nexsys Profile"@en ;
    rdfs:subClassOf nedt:HourlyProfile ;
    nedt:layer "DT-model-extension"@en .

nedt:Archetype a owl:Class ;
    rdfs:label "Building Archetype"@en ;
    rdfs:comment "A canonical residential dwelling category identified by five descriptors: BuildType × BER × Occupancy × HeatingSystem × WeatherClassification." ;
    rdfs:seeAlso gd:Building,
        bot:Building ;
    nedt:layer "core-KG-framework"@en .

nedt:ArchetypeCount a owl:Class ;
    rdfs:label "Archetype Count"@en ;
    rdfs:comment "Number of dwellings of a given archetype in a given county and scenario variant (original, EV, NoEV, PV)." ;
    rdfs:subClassOf ssn:ObservationValue ;
    nedt:layer "DT-model-extension"@en .

