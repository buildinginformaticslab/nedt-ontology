inst:OE_Louth_0412_20350118_1800 a nedt:OverloadEvent ;
    nedt:occursAt "2035-01-18T18:00:00"^^xsd:dateTime ;
    nedt:overloadMagnitude_kW 48.2 .

inst:PVAdoptionScenario_AsIs_2025 a nedt:PVAdoptionScenario ;
    rdfs:label "AS-IS PV adoption (SEAI 2018–2025 cumulative)" ;
    nedt:hasCapacityMix inst:PVCapacityMix_IE2017 ;
    nedt:hasScenarioYear 2025 .

inst:PVReferenceShape_IE_mean a nedt:PVReferenceShape ;
    rdfs:label "Ireland mean PV reference shape (1 kWp, 8760h)" ;
    nedt:annualYield_kWh_per_kWp 1095.0 .

inst:RevFlow_Louth_0412_0 a nedt:ReversePowerFlowHour ;
    time:inXSDDateTimeStamp "2035-05-12T13:00:00Z"^^xsd:dateTimeStamp ;
    nedt:derivedUnder inst:Scenario_S2_2035 .

inst:RevFlow_Louth_0412_1 a nedt:ReversePowerFlowHour ;
    time:inXSDDateTimeStamp "2035-06-14T14:00:00Z"^^xsd:dateTimeStamp ;
    nedt:derivedUnder inst:Scenario_S2_2035 .

inst:RevFlow_Louth_0412_2 a nedt:ReversePowerFlowHour ;
    time:inXSDDateTimeStamp "2035-07-21T12:00:00Z"^^xsd:dateTimeStamp ;
    nedt:derivedUnder inst:Scenario_S2_2035 .

inst:SensRun_S2_2035_HPvsEV a nedt:SensitivityRun ;
    rdfs:label "Sensitivity: HP% vs EV% vs PV kWp · S2 · 2035"@en ;
    prov:used inst:Scenario_S2_2035 .

nedt:BERFallbackRule a owl:Class ;
    rdfs:label "BER Fallback Rule"@en ;
    rdfs:comment "Substitution rule used when no direct profile exists for a BER letter (e.g., F/G folded into E)." ;
    nedt:layer "DT-model-extension"@en .

nedt:Building a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "Physical building entity carrying one or more dwellings. Spatial container aligned to bot:Building and to the GeoDirectory address spine." ;
    rdfs:subClassOf bot:Building ;
    nedt:layer "core-KG-framework"@en .

nedt:BuildingShare a owl:Class ;
    rdfs:label "Building Share"@en ;
    rdfs:seeAlso cim:UsagePoint,
        saragon:hasServiceArea ;
    skos:note "Fractional assignment of buildings to a station; the disaggregated equivalent of enumerating the station's cim:UsagePoint connections."@en ;
    nedt:layer "core-KG-framework"@en .

nedt:CO2Emission a owl:Class ;
    rdfs:label "CO2 Emission"@en ;
    rdfs:subClassOf ssn:ObservationValue ;
    nedt:layer "DT-model-extension"@en .

nedt:CoincidentPeak a owl:Class ;
    rdfs:label "Coincident Peak"@en ;
    rdfs:comment "County- or national-level coincident electrical peak (MW) with its time-stamp."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:ColourPalette a owl:Class ;
    rdfs:label "Colour Palette"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:CountyDemandAggregate a owl:Class ;
    rdfs:label "County Demand Aggregate"@en ;
    rdfs:subClassOf nedt:CountyKPI ;
    nedt:layer "DT-model-extension"@en .

nedt:DTRun a owl:Class ;
    rdfs:label "DT Run"@en ;
    rdfs:comment "A single execution of the digital-twin notebook that produces a bundle of KPIValues. Uses prov:used / prov:generated / prov:wasDerivedFrom directly."@en ;
    rdfs:subClassOf prov:Activity ;
    nedt:layer "DT-model-extension"@en .

nedt:DeltaSeries a owl:Class ;
    rdfs:label "Delta Series"@en ;
    rdfs:comment "Scenario − baseline hourly time series; feeds visualisation and attribution." ;
    rdfs:subClassOf nedt:HourlyProfile ;
    nedt:layer "DT-model-extension"@en .

nedt:DominantDriver a owl:Class ;
    rdfs:label "Dominant Driver"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:EVMode a owl:Class ;
    rdfs:label "EV Charging Mode"@en ;
    rdfs:comment "Controlled charging strategy: uncontrolled / tier-3 / tier-4 / V1H / V2H." ;
    nedt:layer "DT-model-extension"@en .

nedt:ExportedEnergy a owl:Class ;
    rdfs:label "Exported Energy"@en ;
    rdfs:comment "Annual PV energy exported to the grid (kWh)."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:FlexibilityKPI a owl:Class ;
    rdfs:label "LV-node flexibility KPI"@en ;
    rdfs:comment "Shiftable kW at an LV station under a stated demand-response window and scenario / year."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:FlexibleLoad a owl:Class ;
    rdfs:label "Flexible load"@en ;
    rdfs:comment "The subset of an EndUseLoad whose timing can be shifted inside a demand-response window (typically HP, EV and HP_replace end-uses)."@en ;
    rdfs:subClassOf nedt:EndUseLoad ;
    nedt:layer "DT-model-extension"@en .

nedt:GeoLocation a owl:Class ;
    rdfs:label "Geo Location"@en ;
    rdfs:seeAlso geo:Feature ;
    rdfs:subClassOf geo:Feature ;
    nedt:layer "core-KG-framework"@en .

nedt:HPScenario a owl:Class ;
    rdfs:label "Heat-Pump Scenario"@en ;
    rdfs:subClassOf nedt:Scenario ;
    nedt:layer "DT-model-extension"@en .

nedt:HPTransition a owl:Class ;
    rdfs:label "Heat-Pump Transition"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:HVSubstation a owl:Class ;
    rdfs:label "HV Substation"@en ;
    rdfs:comment "High-voltage (110/220 kV) upstream substation; supports MV-to-HV roll-up." ;
    rdfs:seeAlso saragon:DistributionNode ;
    rdfs:subClassOf nedt:NetworkAsset ;
    nedt:layer "core-KG-framework"@en .

nedt:HeatFuelComponent a owl:Class ;
    rdfs:label "Heat Fuel Component"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:HeatLoad a owl:Class ;
    rdfs:label "Heat Load"@en ;
    rdfs:subClassOf nedt:EnergyLoad ;
    nedt:layer "DT-model-extension"@en .

nedt:HullPolygon a owl:Class ;
    rdfs:label "Hull Polygon"@en ;
    rdfs:seeAlso cim:Location,
        geo:Geometry ;
    rdfs:subClassOf geo:Geometry ;
    skos:note "Station service-area polygon (weighted-Voronoi / concave hull). CIM 61968 models per-customer ServiceLocation and asset Location/PositionPoint geometry, but has no aggregate substation service territory — gap filled by NEDT."@en ;
    nedt:layer "core-KG-framework"@en .

nedt:KPIEvaluatedObject a owl:Class ;
    rdfs:label "KPI Evaluated Object"@en ;
    rdfs:comment "Anchor class for whatever a KPI evaluates: County, LV Station, Archetype, or Scenario." ;
    nedt:layer "DT-model-extension"@en .

nedt:LVAggregation a owl:Class ;
    rdfs:label "LV Aggregation Procedure"@en ;
    rdfs:comment "Procedure that sums archetype-level hourly load to the LV-station level via the hull-polygon assignment."@en ;
    rdfs:subClassOf ssn:Procedure ;
    nedt:layer "DT-model-extension"@en .

nedt:LargestRemainderAlloc a owl:Class ;
    rdfs:label "Largest-Remainder Allocation"@en ;
    rdfs:subClassOf ssn:Procedure ;
    nedt:layer "DT-model-extension"@en .

nedt:NetLoad a owl:Class ;
    rdfs:label "Net Load"@en ;
    rdfs:comment "Per-dwelling hourly load after PV netting, clamped at zero (no grid export assumed)." ;
    rdfs:subClassOf nedt:ElectricLoad ;
    nedt:layer "DT-model-extension"@en .

nedt:NettingProcedure a owl:Class ;
    rdfs:label "PV Netting Procedure"@en ;
    rdfs:subClassOf ssn:Procedure ;
    nedt:layer "DT-model-extension"@en .

nedt:PVReferenceShape a owl:Class ;
    rdfs:label "PV Reference Shape"@en ;
    rdfs:comment "Normalised 1 kWp shape derived as the mean of all Nexsys PV columns after peak/0.85 normalisation (~1095 kWh/yr)." ;
    rdfs:subClassOf nedt:PVGenerationProfile ;
    nedt:layer "DT-model-extension"@en .

nedt:ReportSection a owl:Class ;
    rdfs:label "Report Section"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ScenarioAssumption a owl:Class ;
    rdfs:label "Scenario Assumption"@en ;
    rdfs:comment "A written or sourced assumption underpinning a scenario parameter (CAP, SEAI, internal expert judgement)."@en ;
    rdfs:subClassOf prov:Entity ;
    nedt:layer "DT-model-extension"@en .

nedt:SelfConsumptionRatio a owl:Class ;
    rdfs:label "Self-Consumption Ratio"@en ;
    rdfs:comment "Annual PV self-consumption as a fraction (0-1) of generation used on-site."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:SensitivityRun a owl:Class ;
    rdfs:label "Sensitivity Run"@en ;
    rdfs:comment "A parameter-sweep execution that ranks scenario parameters by their marginal effect on county peak and CO2."@en ;
    rdfs:subClassOf prov:Activity ;
    nedt:layer "DT-model-extension"@en .

nedt:SmallArea a owl:Class ;
    rdfs:label "Small Area"@en ;
    rdfs:comment "CSO Census Small Area spatial unit; links dwelling stock to SAPS attributes." ;
    rdfs:seeAlso osi:SmallArea ;
    rdfs:subClassOf geo:Feature ;
    nedt:layer "core-KG-framework"@en .

nedt:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    rdfs:comment "An actor that defines performance goals for the digital twin (e.g., DSO, council, policy maker)." ;
    nedt:layer "core-KG-framework"@en .

nedt:StationCapacity a owl:Class ;
    rdfs:label "Station Capacity"@en ;
    rdfs:seeAlso cim:ApparentPowerLimit,
        cim:PowerTransformerEnd.ratedS ;
    rdfs:subClassOf ssn:ObservationValue ;
    skos:note "designed_kva (and its ambient-corrected variant designed_kva_eff per IEC 60076-2) corresponds to cim:PowerTransformerEnd.ratedS; as a planning limit it corresponds to cim:ApparentPowerLimit."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:StrategicKPI a owl:Class ;
    rdfs:label "Strategic KPI"@en ;
    rdfs:subClassOf nedt:KPI ;
    nedt:layer "DT-model-extension"@en .

