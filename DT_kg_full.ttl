inst:SP_HP_TH_D1_2035 a nedt:ScenarioParameter ;
    rdfs:label "HP uptake"@en ;
    prov:wasDerivedFrom inst:Assumption_CAP_HP ;
    nedt:forArchetype inst:Arch_TH_D1_1971 ;
    nedt:forYear "2035"^^xsd:gYear ;
    nedt:uptakeValue 0.40 .

inst:SP_PV_SD_2035 a nedt:ScenarioParameter ;
    rdfs:label "PV installed kWp"@en ;
    nedt:forArchetype inst:Arch_SD_B2_post2011 ;
    nedt:forYear "2035"^^xsd:gYear ;
    nedt:uptakeValue 4.0 .

nedt:BERRating a owl:Class ;
    rdfs:label "BER Rating"@en ;
    rdfs:comment "Building Energy Rating letter (A1-G) assigned to a dwelling archetype by SEAI."@en ;
    rdfs:subClassOf nedt:ArchetypeDescriptor ;
    nedt:layer "DT-model-extension"@en .

nedt:ChartJSChart a owl:Class ;
    rdfs:label "Chart.js Chart"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ConstructionPeriod a owl:Class ;
    rdfs:label "Construction Period"@en ;
    rdfs:comment "CSO / SEAI construction-period band (pre-1919, 1919-1945, 1946-1970, 1971-1990, 1991-2010, post-2011)."@en ;
    rdfs:subClassOf nedt:ArchetypeDescriptor ;
    nedt:layer "DT-model-extension"@en .

nedt:ContribRank a owl:Class ;
    rdfs:label "Contribution Rank"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:CountyKPI a owl:Class ;
    rdfs:label "County KPI"@en ;
    rdfs:comment "A KPI definition whose values are always scoped to one county (via nedt:evaluatesCounty on the KPIValue)."@en ;
    rdfs:subClassOf nedt:KPI ;
    nedt:layer "DT-model-extension"@en .

nedt:CountySummary a owl:Class ;
    rdfs:label "County Summary"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:DHViabilityKPI a owl:Class ;
    rdfs:label "District-heating viability KPI"@en ;
    rdfs:comment "Carries the boolean viability verdict and the underlying heat density for one cluster / county / scenario / year."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:DwellingType a owl:Class ;
    rdfs:label "Dwelling Type"@en ;
    rdfs:comment "Structural dwelling type: detached, semi-detached, terrace, end-of-terrace, apartment."@en ;
    rdfs:subClassOf nedt:ArchetypeDescriptor ;
    nedt:layer "DT-model-extension"@en .

nedt:EVScenario a owl:Class ;
    rdfs:label "EV Scenario"@en ;
    rdfs:subClassOf nedt:Scenario ;
    nedt:layer "DT-model-extension"@en .

nedt:HeatDensity a owl:Class ;
    rdfs:label "Heat Density"@en,
        "Heat demand density"@en ;
    rdfs:comment "kWh/m² or equivalent per spatial cell; supports district-heating feasibility analysis.",
        "Annual thermal demand per unit floor or land area (kWh·m⁻²·yr⁻¹) evaluated at a grid cell, SA cluster or dwelling group."@en ;
    rdfs:subClassOf sosa:ObservableProperty,
        ssn:ObservationValue ;
    nedt:layer "DT-model-extension"@en .

nedt:HeatDensityGDF a owl:Class ;
    rdfs:label "Heat Density GeoDataFrame"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:KPICalculation a owl:Class ;
    rdfs:label "KPI Calculation"@en ;
    rdfs:subClassOf ssn:Procedure ;
    nedt:layer "DT-model-extension"@en .

nedt:MVFeeder a owl:Class ;
    rdfs:label "MV Feeder"@en ;
    rdfs:comment "Medium-voltage (38 kV) parent network asset; supports LV-to-MV roll-up." ;
    rdfs:seeAlso saragon:DistributionNode ;
    rdfs:subClassOf nedt:NetworkAsset ;
    nedt:layer "core-KG-framework"@en .

nedt:NationalKPI a owl:Class ;
    rdfs:label "National KPI"@en ;
    rdfs:comment "A KPI definition whose values are aggregated across all 26 counties."@en ;
    rdfs:subClassOf nedt:KPI ;
    nedt:layer "DT-model-extension"@en .

nedt:PVCapacityMix a owl:Class ;
    rdfs:label "PV Capacity Mix"@en ;
    rdfs:comment "Probability distribution over PVCapacityBins. Default Irish 2017 reference: 10/47/23/6/11/3%." ;
    nedt:layer "DT-model-extension"@en .

nedt:PVGenerationProfile a owl:Class ;
    rdfs:label "PV Generation Profile"@en ;
    rdfs:comment "Hourly kW generation; empirically collapses to one weather-driven reference shape across archetypes (cosine similarity ≥ 0.96)." ;
    rdfs:subClassOf nedt:HourlyProfile ;
    nedt:layer "DT-model-extension"@en .

nedt:PerformanceGoal a owl:Class ;
    rdfs:label "Performance Goal"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ProfileKey a owl:Class ;
    rdfs:label "Profile Key"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:RiskTable a owl:Class ;
    rdfs:label "Risk Table"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ScenarioOperator a owl:Class ;
    rdfs:label "Scenario Operator"@en ;
    rdfs:comment "An action that modifies stock composition or technology state, e.g. converting a fraction of oil-heated dwellings to heat pumps." ;
    nedt:layer "DT-model-extension"@en .

nedt:StationLoad a owl:Class ;
    rdfs:label "Station Load"@en ;
    rdfs:seeAlso cim:Analog,
        cim:AnalogValue ;
    rdfs:subClassOf nedt:ElectricLoad ;
    skos:note "Hourly aggregated kVA at the station; corresponds to a cim:AnalogValue of a cim:Analog measurement on the transformer LV terminal. In NEDT it is model-derived, not telemetered."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ThermalDemandCluster a owl:Class ;
    rdfs:label "Thermal-demand cluster"@en ;
    rdfs:comment "A contiguous group of archetypes / cells whose aggregated HeatDensity exceeds a threshold, produced by the DH-viability procedure."@en ;
    rdfs:seeAlso bot:Zone ;
    nedt:layer "DT-model-extension"@en .

nedt:TopTransitions a owl:Class ;
    rdfs:label "Top Transitions"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:TransitionLedger a owl:Class ;
    rdfs:label "Transition Ledger"@en ;
    rdfs:comment "Record of how dwellings migrate between heating systems or BER levels under a scenario." ;
    nedt:layer "DT-model-extension"@en .

nedt:Utilisation a owl:Class ;
    rdfs:label "Utilisation"@en ;
    rdfs:seeAlso cim:OperationalLimitSet ;
    rdfs:subClassOf ssn:ObservationValue ;
    skos:note "Peak load / effective rating ratio; CIM expresses the limit (OperationalLimitSet/ApparentPowerLimit) but not the computed utilisation ratio or its status bands — gap filled by NEDT."@en ;
    nedt:layer "DT-model-extension"@en .

inst:Arch_Bungalow_B_2_gasboiler a nedt:Archetype ;
