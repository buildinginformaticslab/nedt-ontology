nedt:LVStation a owl:Class ;
    rdfs:label "LV Substation"@en ;
    rdfs:comment "A low-voltage distribution substation (ESB Networks). Each dwelling is assigned to exactly one station via hull polygon." ;
    rdfs:seeAlso cim:PowerTransformer,
        saragon:DistributionNode ;
    rdfs:subClassOf cim:Substation,
        nedt:NetworkAsset,
        saragon:Transformer ;
    skos:closeMatch saragon:Transformer ;
    skos:note "One-to-one with its MV/LV transformer in the ESB dataset, so the station also stands proxy for cim:PowerTransformer; the station's designed kVA is the transformer's cim:PowerTransformerEnd.ratedS."@en ;
