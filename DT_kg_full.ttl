nedt:DatumSource a owl:Class ;
    rdfs:label "Datum Source"@en ;
    rdfs:comment "A bound input dataset (CSV, parquet, GeoJSON, shapefile) that provides observations to a KPI calculation." ;
    nedt:layer "core-KG-framework"@en .

nedt:Dwelling a owl:Class ;
    rdfs:label "Dwelling"@en ;
    rdfs:comment "A residential unit within a building. Core unit for archetype assignment and for transformer linkage via nedt:isServedBy." ;
    rdfs:subClassOf bot:Zone ;
    nedt:layer "core-KG-framework"@en .

nedt:ElectricLoad a owl:Class ;
    rdfs:label "Electric Load"@en ;
    rdfs:seeAlso cim:EnergyConsumer ;
    rdfs:subClassOf nedt:EnergyLoad ;
    skos:note "nedt models the aggregate demand quantity; in CIM the demand lives as EnergyConsumer.p / EnergyConsumer.q on the consuming-equipment class."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:HourlyProfile a owl:Class ;
    rdfs:label "Hourly Profile"@en ;
    rdfs:comment "An 8760-hour time-series observation attached to an archetype or aggregated entity." ;
    rdfs:seeAlso cim:IntervalBlock,
        cim:RegularIntervalSchedule ;
    skos:note "8760-hour demand/generation shapes; schedule-like (RegularIntervalSchedule) rather than metered readings."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:PVSystem a owl:Class ;
    rdfs:label "Rooftop PV System"@en ;
    rdfs:comment "A dwelling-mounted photovoltaic system characterised by installed capacity (kWp) and generation profile. Apartments are excluded." ;
    rdfs:seeAlso cim:PhotoVoltaicUnit ;
    skos:note "Dwelling rooftop PV, kWp-binned; corresponds to cim:PhotoVoltaicUnit (a cim:PowerElectronicsUnit) in CIM100/CGMES 3.0."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ScenarioParameter a owl:Class ;
    rdfs:label "Scenario Parameter"@en ;
    rdfs:comment "One numeric parameter of a scenario (HP uptake fraction, EV uptake fraction, PV kWp) bound to a single archetype and year. Value carried by nedt:uptakeValue."@en ;
    nedt:layer "DT-model-extension"@en .

