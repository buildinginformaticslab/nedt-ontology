@prefix bot: <https://w3id.org/bot#> .
@prefix cim: <http://iec.ch/TC57/CIM100#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix gd: <https://example.org/geodirectory#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix inst: <https://example.org/nedt/inst/> .
@prefix nedt: <https://example.org/nedt#> .
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix osi: <https://example.org/osi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saragon: <https://w3id.org/saragon#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/nedt> a owl:Ontology ;
    dct:creator "Cathal Hoare",
        "Divyanshu Sood",
        "James O'Donnell",
        "Sharon Coffee" ;
    dct:description "An OWL ontology describing building archetypes, hourly energy profiles, LV-network attribution, scenarios (including rooftop-PV adoption), KPI evaluation and visualisation components of the National Energy Digital Twin (NEDT) for Ireland."@en ;
    dct:issued "2026-04-20T00:00:00+00:00"^^xsd:dateTime ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-07-16T00:00:00+00:00"^^xsd:dateTime ;
    dct:title "National Energy Digital Twin (NEDT) Ontology"@en ;
    rdfs:seeAlso om:,
        <https://www.w3.org/2006/time>,
        <https://www.w3.org/ns/ssn/> ;
    owl:versionInfo "1.4.0" ;
    skos:note "Structurally aligned with Li et al. (2019) EM-KPI ontology and reuses SSN/SOSA for observations, OWL-Time for temporal intervals, OM-2 for units and GeoSPARQL for spatial geometries."@en .

nedt:ArchetypeState a owl:Class ;
    rdfs:label "Archetype State"@en ;
    rdfs:comment "Baseline or scenario-specific condition of an archetype cohort." ;
    rdfs:subClassOf nedt:TechnologyState ;
    nedt:layer "DT-model-extension"@en .

nedt:DemandProfile a owl:Class ;
    rdfs:label "Demand Profile"@en ;
    rdfs:comment "An hourly or otherwise structured demand profile, baseline or scenario-specific." ;
    rdfs:subClassOf nedt:HourlyProfile ;
    nedt:layer "DT-model-extension"@en .

nedt:DemandResponseCapacity a owl:Class ;
    rdfs:label "Demand-response capacity"@en ;
    rdfs:comment "Head-room (kW) available to a DR programme at an LV node after accounting for comfort and SOC constraints."@en ;
    rdfs:seeAlso cim:DemandResponseProgram ;
    rdfs:subClassOf nedt:KPIValue ;
    skos:note "Shiftable kW at the LV node; CIM 61968-9 models the programme construct (DemandResponseProgram + controls), not the aggregate capacity quantity."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:GasBoiler a owl:Class ;
    rdfs:label "Gas Boiler"@en ;
    rdfs:subClassOf nedt:HeatingSystem ;
    nedt:layer "core-KG-framework"@en .

nedt:GroupHeatingCandidate a owl:Class ;
    rdfs:label "Group / community heating candidate"@en ;
    rdfs:comment "A ThermalDemandCluster in the 50–120 kWh·m⁻²·yr⁻¹ band whose compactness and dwelling-mix make it suitable for a shared-plant scheme."@en ;
    rdfs:subClassOf nedt:ThermalDemandCluster ;
    nedt:layer "DT-model-extension"@en .

nedt:HeatPump a owl:Class ;
    rdfs:label "Heat Pump"@en ;
    rdfs:subClassOf nedt:HeatingSystem ;
    nedt:layer "core-KG-framework"@en .

nedt:LoadMetric a owl:Class ;
    rdfs:label "Load Metric"@en ;
    rdfs:subClassOf ssn:ObservationValue ;
    nedt:layer "DT-model-extension"@en .

nedt:NationalDemandAggregate a owl:Class ;
    rdfs:label "National Demand Aggregate"@en ;
    rdfs:subClassOf nedt:NationalKPI ;
    nedt:layer "DT-model-extension"@en .

nedt:OccupancyModel a owl:Class ;
    rdfs:label "Occupancy Model"@en ;
    rdfs:comment "The model used to generate occupancy profiles for archetype simulation." ;
    nedt:layer "DT-model-extension"@en .

nedt:OccupancyProfile a owl:Class ;
    rdfs:label "Occupancy Profile"@en ;
    rdfs:subClassOf nedt:HourlyProfile ;
    nedt:layer "DT-model-extension"@en .

nedt:OilBoiler a owl:Class ;
    rdfs:label "Oil Boiler"@en ;
    rdfs:subClassOf nedt:HeatingSystem ;
    nedt:layer "core-KG-framework"@en .

nedt:OperationalKPI a owl:Class ;
    rdfs:label "Operational KPI"@en ;
    rdfs:subClassOf nedt:KPI ;
    nedt:layer "DT-model-extension"@en .

nedt:TacticalKPI a owl:Class ;
    rdfs:label "Tactical KPI"@en ;
    rdfs:subClassOf nedt:KPI ;
    nedt:layer "DT-model-extension"@en .

nedt:V1HCharger a owl:Class ;
    rdfs:label "V1H Charger"@en ;
    rdfs:comment "Unidirectional smart charger (controlled charging, no export)." ;
    rdfs:subClassOf nedt:EVCharger ;
    nedt:layer "DT-model-extension"@en .

nedt:V2HCharger a owl:Class ;
    rdfs:label "V2H Charger"@en ;
    rdfs:comment "Bidirectional vehicle-to-home charger (controlled charging with discharge)." ;
    rdfs:subClassOf nedt:EVCharger ;
    nedt:layer "DT-model-extension"@en .

nedt:adoptionFraction a owl:DatatypeProperty ;
    rdfs:comment "Fraction of eligible (non-apartment) dwellings that have PV installed." ;
    rdfs:domain nedt:PVAdoptionScenario ;
    rdfs:range xsd:decimal .

nedt:aggregatesDemandFrom a owl:ObjectProperty ;
    rdfs:label "aggregates demand from"@en ;
    rdfs:comment "Supports multi-scale roll-up from dwelling and station demand to county and national aggregates." .

nedt:allocatedBy a owl:ObjectProperty ;
    rdfs:domain nedt:TransitionLedger ;
    rdfs:range nedt:LargestRemainderAlloc .

nedt:appliesScenarioOperator a owl:ObjectProperty ;
    rdfs:label "applies scenario operator"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range nedt:ScenarioOperator .

nedt:assemblesReport a owl:ObjectProperty ;
    rdfs:label "assembles report"@en ;
    rdfs:domain nedt:FigCollector ;
    rdfs:range nedt:HTMLReport .

nedt:attributedToEndUse a owl:ObjectProperty ;
    rdfs:label "attributed to end-use"@en ;
    rdfs:domain nedt:EndUseContribution ;
    rdfs:range nedt:EndUseLoad .

nedt:breachHours a owl:DatatypeProperty ;
    rdfs:label "breach hours per year"@en ;
    rdfs:domain nedt:ReinforcementNeed ;
    rdfs:range xsd:integer .

nedt:changesTechnologyState a owl:ObjectProperty ;
    rdfs:label "changes technology state"@en ;
    rdfs:domain nedt:ScenarioOperator ;
    rdfs:range nedt:TechnologyTransition .

nedt:clusterCompactness a owl:DatatypeProperty ;
    rdfs:label "cluster compactness ratio (0–1)"@en ;
    rdfs:domain nedt:ThermalDemandCluster ;
    rdfs:range xsd:decimal .

nedt:collectsChart a owl:ObjectProperty ;
    rdfs:label "collects chart"@en ;
    rdfs:domain nedt:FigCollector ;
    rdfs:range nedt:ChartJSChart .

nedt:collectsMap a owl:ObjectProperty ;
    rdfs:label "collects map"@en ;
    rdfs:domain nedt:FigCollector ;
    rdfs:range nedt:DeckGLMap .

nedt:computesDelta a owl:ObjectProperty ;
    rdfs:domain nedt:LoadCalculation ;
    rdfs:range nedt:DeltaSeries .

nedt:computesDensity a owl:ObjectProperty ;
    rdfs:domain nedt:LoadCalculation ;
    rdfs:range nedt:HeatDensity .

nedt:computesLoad a owl:ObjectProperty ;
    rdfs:domain nedt:LoadCalculation ;
    rdfs:range nedt:EnergyLoad .

nedt:contains a owl:ObjectProperty ;
    rdfs:domain nedt:County ;
    rdfs:range nedt:LVStation ;
    rdfs:seeAlso cim:SubGeographicalRegion.Substations .

nedt:contributionPercent a owl:DatatypeProperty ;
    rdfs:label "contribution percent"@en ;
    rdfs:comment "Share 0-100 of the overload attributable to this end-use."@en ;
    rdfs:domain nedt:EndUseContribution ;
    rdfs:range xsd:decimal .

nedt:controllableFraction a owl:DatatypeProperty ;
    rdfs:label "controllable fraction (0–1)"@en ;
    rdfs:domain nedt:FlexibleLoad ;
    rdfs:range xsd:decimal .

nedt:derivedFromGrant a owl:ObjectProperty ;
    rdfs:domain nedt:PVAdoptionScenario ;
    rdfs:range nedt:SEAIGrantRecord .

nedt:derivedUnder a owl:ObjectProperty ;
    rdfs:label "derived under scenario"@en ;
    rdfs:domain nedt:KPIValue ;
    rdfs:range nedt:Scenario .

nedt:eligibleBER a owl:DatatypeProperty ;
    rdfs:comment "All BER letters A–E admitted; no BER restriction in default deployment." ;
    rdfs:domain nedt:PVSystem ;
    rdfs:range xsd:string .

nedt:endUse a owl:DatatypeProperty ;
    rdfs:label "end-use"@en ;
    rdfs:comment "Enumerated end-use tag: space_heat | dhw | appliance | lighting | cooking | ev | hp_replace."@en ;
    rdfs:domain nedt:EndUseLoad ;
    rdfs:range xsd:string .

nedt:evaluatedUnderScenario a owl:ObjectProperty ;
    rdfs:label "evaluated under scenario"@en ;
    rdfs:comment "Links a demand profile, KPI or archetype state to the scenario under which it was produced. Domain is the union of DemandProfile, KPI and ArchetypeState." ;
    rdfs:range nedt:Scenario .

nedt:evaluatesCounty a owl:ObjectProperty ;
    rdfs:label "evaluates county"@en ;
    rdfs:domain nedt:KPIValue ;
    rdfs:range nedt:County .

nedt:evaluatesYear a owl:DatatypeProperty ;
    rdfs:label "evaluates year"@en ;
    rdfs:domain nedt:KPIValue ;
    rdfs:range xsd:integer .

nedt:feeds a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "feeds"@en ;
    rdfs:comment "Downstream direction of hasUpstreamAsset; aligned in intent with the SARAGON feeds relation." ;
    rdfs:domain nedt:NetworkAsset ;
    rdfs:range nedt:NetworkAsset ;
    owl:inverseOf nedt:hasUpstreamAsset .

nedt:firstBreachYear a owl:DatatypeProperty ;
    rdfs:label "first breach year"@en ;
    rdfs:domain nedt:ReinforcementNeed ;
    rdfs:range xsd:integer .

nedt:flexibilityKW a owl:DatatypeProperty ;
    rdfs:label "shiftable load (kW)"@en ;
    rdfs:domain nedt:FlexibilityKPI ;
    rdfs:range xsd:decimal .

nedt:forArchetype a owl:ObjectProperty ;
    rdfs:label "for archetype"@en ;
    rdfs:domain nedt:ScenarioParameter ;
    rdfs:range nedt:Archetype .

nedt:forCounty a owl:ObjectProperty ;
    rdfs:label "for county"@en ;
    rdfs:range nedt:County .

nedt:forLVStation a owl:ObjectProperty ;
    rdfs:label "for LV station"@en ;
    rdfs:domain nedt:CapacityKPI ;
    rdfs:range nedt:LVStation .

nedt:forYear a owl:DatatypeProperty ;
    rdfs:label "for year"@en ;
    rdfs:domain nedt:ScenarioParameter ;
    rdfs:range xsd:integer .

nedt:fromArchetype a owl:ObjectProperty ;
    rdfs:label "from archetype"@en ;
    rdfs:domain nedt:TechnologyTransition ;
    rdfs:range nedt:Archetype .

nedt:fromScenario a owl:ObjectProperty ;
    rdfs:label "from scenario"@en ;
    rdfs:domain nedt:StationTransition ;
    rdfs:range nedt:Scenario .

nedt:grantCount a owl:DatatypeProperty ;
    rdfs:domain nedt:SEAIGrantRecord ;
    rdfs:range xsd:integer .

nedt:grantFundingEUR a owl:DatatypeProperty ;
    rdfs:domain nedt:SEAIGrantRecord ;
    rdfs:range xsd:decimal .

nedt:grantYear a owl:DatatypeProperty ;
    rdfs:domain nedt:SEAIGrantRecord ;
    rdfs:range xsd:integer .

nedt:hasArchetype a owl:ObjectProperty ;
    rdfs:domain nedt:County ;
    rdfs:range nedt:Archetype .

nedt:hasAssignmentDistanceM a owl:DatatypeProperty ;
    rdfs:label "assignment distance (m)"@en ;
    rdfs:domain nedt:Dwelling ;
    rdfs:range xsd:decimal .

nedt:hasAssociatedKPI a owl:ObjectProperty ;
    rdfs:domain nedt:PerformanceGoal ;
    rdfs:range nedt:KPI .

nedt:hasAttribution a owl:ObjectProperty ;
    rdfs:domain nedt:OverloadedStation ;
    rdfs:range nedt:OverloadAttribution .

nedt:hasBERCategory a owl:DatatypeProperty ;
    rdfs:label "BER category"@en ;
    rdfs:domain nedt:Archetype ;
    rdfs:range xsd:string .

nedt:hasBERFallback a owl:ObjectProperty ;
    rdfs:domain nedt:Archetype ;
    rdfs:range nedt:BERFallbackRule .

nedt:hasBldgShare a owl:ObjectProperty ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:BuildingShare .

nedt:hasBuildType a owl:DatatypeProperty ;
    rdfs:label "build type"@en ;
    rdfs:domain nedt:Archetype ;
    rdfs:range xsd:string .

nedt:hasCO2 a owl:ObjectProperty ;
    rdfs:domain nedt:EnergyLoad ;
    rdfs:range nedt:CO2Emission .

nedt:hasCalculation a owl:ObjectProperty ;
    rdfs:domain nedt:KPI ;
    rdfs:range nedt:KPICalculation .

nedt:hasCapacity a owl:ObjectProperty ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:StationCapacity .

nedt:hasCapacityBin a owl:ObjectProperty ;
    rdfs:domain nedt:PVSystem ;
    rdfs:range nedt:PVCapacityBin .

nedt:hasCapacityImputed a owl:DatatypeProperty ;
    rdfs:label "capacity imputed"@en ;
    rdfs:comment "True where the rated capacity was not available from the source asset register and a default was substituted. Consumers must treat utilisation for such stations as indicative only." ;
    rdfs:domain nedt:LVStation ;
    rdfs:range xsd:boolean .

nedt:hasCapacityMix a owl:ObjectProperty ;
    rdfs:domain nedt:PVAdoptionScenario ;
    rdfs:range nedt:PVCapacityMix .

nedt:hasCapacityValue a owl:DatatypeProperty ;
    rdfs:label "rated capacity (kVA)"@en ;
    rdfs:comment "Rated (nameplate) apparent-power capacity in kVA." ;
    rdfs:domain nedt:LVStation ;
    rdfs:range xsd:decimal .

nedt:hasChart a owl:ObjectProperty ;
    rdfs:domain nedt:HTMLReport ;
    rdfs:range nedt:ChartJSChart .

nedt:hasCoincidenceFactor a owl:DatatypeProperty ;
    rdfs:label "coincidence factor applied"@en ;
    rdfs:domain nedt:StationLoad ;
    rdfs:range xsd:decimal .

nedt:hasCount a owl:ObjectProperty ;
    rdfs:domain nedt:Archetype ;
    rdfs:range nedt:ArchetypeCount .

nedt:hasCountyCalibrationFactor a owl:DatatypeProperty ;
    rdfs:label "county electricity calibration factor"@en ;
    rdfs:comment "Multiplicative factor applied to modelled county electricity so that annual totals reconcile with CSO metered consumption. Recorded explicitly so that calibrated outputs are never mistaken for independent validation." ;
    rdfs:domain nedt:CountyDemandAggregate ;
    rdfs:range xsd:decimal .

nedt:hasCountySummary a owl:ObjectProperty ;
    rdfs:label "has county summary"@en ;
    rdfs:domain nedt:County ;
    rdfs:range nedt:CountySummary .

nedt:hasDeckMap a owl:ObjectProperty ;
    rdfs:domain nedt:HTMLReport ;
    rdfs:range nedt:DeckGLMap .

nedt:hasDescriptor a owl:ObjectProperty ;
    rdfs:domain nedt:Archetype ;
    rdfs:range nedt:ArchetypeDescriptor .

nedt:hasDisaggregation a owl:ObjectProperty ;
    rdfs:domain nedt:StrategicKPI ;
    rdfs:range nedt:KPI .

nedt:hasDominantDriver a owl:ObjectProperty ;
    rdfs:label "has dominant driver"@en ;
    rdfs:domain nedt:OverloadAttribution ;
    rdfs:range nedt:DominantDriver .

nedt:hasDwelling a owl:ObjectProperty ;
    rdfs:label "has dwelling"@en ;
    rdfs:domain nedt:Building ;
    rdfs:range nedt:Dwelling .

nedt:hasEV a owl:ObjectProperty ;
    rdfs:domain nedt:ElectricLoad ;
    rdfs:range nedt:EVScenario .

nedt:hasEVAdoptionFraction a owl:DatatypeProperty ;
    rdfs:label "EV adoption fraction"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range xsd:decimal .

nedt:hasEVCharger a owl:ObjectProperty ;
    rdfs:label "has EV charger"@en ;
    rdfs:domain nedt:Dwelling ;
    rdfs:range nedt:EVCharger .

nedt:hasElec a owl:ObjectProperty ;
    rdfs:domain nedt:EnergyLoad ;
    rdfs:range nedt:ElectricLoad .

nedt:hasEvalTimeStep a owl:ObjectProperty ;
    rdfs:domain nedt:KPICalculation ;
    rdfs:range time:Interval .

nedt:hasFuelComponent a owl:ObjectProperty ;
    rdfs:domain nedt:HeatDensityGDF ;
    rdfs:range nedt:HeatFuelComponent .

nedt:hasHP a owl:ObjectProperty ;
    rdfs:domain nedt:ElectricLoad ;
    rdfs:range nedt:HPScenario .

nedt:hasHPAdoptionFraction a owl:DatatypeProperty ;
    rdfs:label "HP adoption fraction"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range xsd:decimal .

nedt:hasHeat a owl:ObjectProperty ;
    rdfs:domain nedt:EnergyLoad ;
    rdfs:range nedt:HeatLoad .

nedt:hasHull a owl:ObjectProperty ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:HullPolygon .

nedt:hasKPIDefinition a owl:DatatypeProperty ;
    rdfs:domain nedt:KPI ;
    rdfs:range xsd:string .

nedt:hasKPIEvaluatedObject a owl:ObjectProperty ;
    rdfs:domain nedt:KPI ;
    rdfs:range nedt:KPIEvaluatedObject .

nedt:hasLoad a owl:ObjectProperty ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:StationLoad .

nedt:hasMeasuredValue a owl:DatatypeProperty ;
    rdfs:label "measured value"@en ;
    rdfs:domain nedt:ValidationObservation ;
    rdfs:range xsd:decimal .

nedt:hasMode a owl:ObjectProperty ;
    rdfs:domain nedt:EVScenario ;
    rdfs:range nedt:EVMode .

nedt:hasOccupancyCategory a owl:DatatypeProperty ;
    rdfs:label "occupancy category"@en ;
    rdfs:domain nedt:Archetype ;
    rdfs:range xsd:integer .

nedt:hasOverloadHours a owl:DatatypeProperty ;
    rdfs:label "overload hours"@en ;
    rdfs:domain nedt:CapacityKPI ;
    rdfs:range xsd:integer .

nedt:hasPVAdoptionFraction a owl:DatatypeProperty ;
    rdfs:label "PV adoption fraction"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range xsd:decimal .

nedt:hasPVProfile a owl:ObjectProperty ;
    rdfs:domain nedt:PVSystem ;
    rdfs:range nedt:PVGenerationProfile .

nedt:hasPVSystem a owl:ObjectProperty ;
    rdfs:domain nedt:Archetype ;
    rdfs:range nedt:PVSystem .

nedt:hasParentHVSubstation a owl:ObjectProperty ;
    rdfs:label "has parent HV substation"@en ;
    rdfs:domain nedt:MVFeeder ;
    rdfs:range nedt:HVSubstation ;
    rdfs:subPropertyOf nedt:hasUpstreamAsset .

nedt:hasParentMVFeeder a owl:ObjectProperty ;
    rdfs:label "has parent MV feeder"@en ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:MVFeeder ;
    rdfs:subPropertyOf nedt:hasUpstreamAsset .

nedt:hasPeakDemandKW a owl:DatatypeProperty ;
    rdfs:label "peak demand (kW)"@en ;
    rdfs:domain nedt:CapacityKPI ;
    rdfs:range xsd:decimal .

nedt:hasPerformanceGoal a owl:ObjectProperty ;
    rdfs:domain nedt:Stakeholder ;
    rdfs:range nedt:PerformanceGoal .

nedt:hasProfileKey a owl:ObjectProperty ;
    rdfs:label "has profile key"@en ;
    rdfs:domain nedt:Archetype ;
    rdfs:range nedt:ProfileKey .

nedt:hasRatedCapacityKVA a owl:DatatypeProperty ;
    rdfs:label "rated capacity (kVA)"@en ;
    rdfs:domain nedt:CapacityKPI ;
    rdfs:range xsd:decimal .

nedt:hasRiskTable a owl:ObjectProperty ;
    rdfs:label "has risk table"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range nedt:RiskTable .

nedt:hasScenarioParameter a owl:ObjectProperty ;
    rdfs:label "has scenario parameter"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range nedt:ScenarioParameter .

nedt:hasScenarioYear a owl:DatatypeProperty ;
    rdfs:label "scenario year"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range xsd:integer .

nedt:hasSections a owl:ObjectProperty ;
    rdfs:domain nedt:HTMLReport ;
    rdfs:range nedt:ReportSection .

nedt:hasServiceArea a owl:ObjectProperty ;
    rdfs:label "has service area"@en ;
    rdfs:domain nedt:LVStation ;
    rdfs:range geo:Feature .

nedt:hasStationTransition a owl:ObjectProperty ;
    rdfs:label "has station transition"@en ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:StationTransition .

nedt:hasStatus a owl:ObjectProperty ;
    rdfs:domain nedt:Utilisation ;
    rdfs:range nedt:UtilisationStatus .

nedt:hasTariff a owl:ObjectProperty ;
    rdfs:domain nedt:ElectricLoad ;
    rdfs:range nedt:Tariff .

nedt:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp"@en ;
    rdfs:domain nedt:ValidationObservation ;
    rdfs:range xsd:dateTime .

nedt:hasTopTransitions a owl:ObjectProperty ;
    rdfs:label "has top transitions"@en ;
    rdfs:domain nedt:Scenario ;
    rdfs:range nedt:TopTransitions .

nedt:hasTransition a owl:ObjectProperty ;
    rdfs:domain nedt:Scenario ;
    rdfs:range nedt:HPTransition .

nedt:hasTransitionKey a owl:ObjectProperty ;
    rdfs:domain nedt:Archetype ;
    rdfs:range nedt:TransitionKey .

nedt:hasUtilisation a owl:ObjectProperty ;
    rdfs:domain nedt:LVStation ;
    rdfs:range nedt:Utilisation .

nedt:heatDemand_kWh_per_m2_yr a owl:DatatypeProperty ;
    rdfs:label "heat demand (kWh/m²·yr)"@en ;
    rdfs:domain nedt:HeatDensity ;
    rdfs:range xsd:decimal .

nedt:inCounty a owl:ObjectProperty ;
    rdfs:domain nedt:ArchetypeCount ;
    rdfs:range nedt:County .

nedt:installedCapacity_kWp a owl:DatatypeProperty ;
    rdfs:domain nedt:PVSystem ;
    rdfs:range xsd:decimal .

nedt:instantiatesArchetype a owl:ObjectProperty ;
    rdfs:label "instantiates archetype"@en ;
    rdfs:domain nedt:Dwelling ;
    rdfs:range nedt:Archetype .

nedt:isDHViable a owl:DatatypeProperty ;
    rdfs:label "is DH viable"@en ;
    rdfs:domain nedt:DHViabilityKPI ;
    rdfs:range xsd:boolean .

nedt:isProvidedBy a owl:ObjectProperty ;
    rdfs:domain nedt:DatumSource ;
    rdfs:range ssn:Observation .

nedt:isServedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is served by"@en ;
    rdfs:comment "Links each dwelling to its assigned candidate serving MV/LV transformer. Functional: the enrichment assigns exactly one station per dwelling. Equivalent to the NEAREST_LV_STATION relationship in the Neo4j property-graph deployment." ;
    rdfs:domain nedt:Dwelling ;
    rdfs:range nedt:LVStation .

nedt:layer a owl:AnnotationProperty ;
    rdfs:label "contribution layer"@en ;
    rdfs:comment "One of: 'core-KG-framework' (exists in the utility-aware KG of Hoare et al. 2026 and associated standard ontologies such as BOT / SARAGON / GeoDirectory / OSI) or 'DT-model-extension' (contributed by this National Energy Digital Twin)."@en .

nedt:listsStation a owl:ObjectProperty ;
    rdfs:label "lists overloaded station"@en ;
    rdfs:domain nedt:RiskTable ;
    rdfs:range nedt:OverloadedStation .

nedt:listsTransition a owl:ObjectProperty ;
    rdfs:label "lists station transition"@en ;
    rdfs:domain nedt:TopTransitions ;
    rdfs:range nedt:StationTransition .

nedt:locatedInCounty a owl:ObjectProperty ;
    rdfs:label "located in county"@en ;
    rdfs:comment "Domain is the union of Building, Dwelling and LVStation." ;
