nedt:DeckGLMap a owl:Class ;
    rdfs:label "Deck.GL Map"@en ;
    nedt:layer "DT-model-extension"@en .

nedt:EVCharger a owl:Class ;
    rdfs:label "EV Charger"@en ;
    rdfs:comment "Electric-vehicle charging device associated with a dwelling." ;
    nedt:layer "core-KG-framework"@en .

nedt:FigCollector a owl:Class ;
    rdfs:label "Figure Collector"@en ;
    rdfs:comment "In-memory buffer that captures matplotlib / Deck.GL / Chart.js output for later assembly into HTML." ;
    nedt:layer "DT-model-extension"@en .

nedt:OverloadEvent a owl:Class ;
    rdfs:label "Overload Event"@en ;
    rdfs:comment "Single-hour exceedance of an LV station's nameplate capacity in a scenario run."@en ;
    nedt:layer "DT-model-extension"@en .

nedt:ReinforcementNeed a owl:Class ;
    rdfs:label "Reinforcement Need"@en ;
    rdfs:comment "Flag value carrying first-breach year and annual breach-hours for a station or county."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:ReversePowerFlowHour a owl:Class ;
    rdfs:label "Reverse Power-Flow Hour"@en ;
    rdfs:comment "An hour with negative net flow at the LV transformer (local PV generation exceeds local consumption)."@en ;
    rdfs:subClassOf nedt:KPIValue ;
    nedt:layer "DT-model-extension"@en .

nedt:ValidationObservation a owl:Class ;
    rdfs:label "Validation Observation"@en ;
    rdfs:comment "A measured observation used to validate a modelled output, e.g. a CSO county electricity series or an ESB Networks published station utilisation value." ;
    rdfs:subClassOf sosa:Observation ;
    nedt:layer "DT-model-extension"@en .

nedt:hasUpstreamAsset a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has upstream asset"@en ;
    rdfs:comment "Transitive super-property of the parent-link properties. Because hasParentMVFeeder and hasParentHVSubstation are both sub-properties, an OWL 2 reasoner entails the full LV -> MV -> HV chain from the two published one-step links, so demand can be rolled up to any tier without materialising the closure in the A-Box." ;
    rdfs:domain nedt:NetworkAsset ;
    rdfs:range nedt:NetworkAsset .

